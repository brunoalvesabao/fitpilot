NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Necessária para a importação de alunos com IA (/app/alunos/importar).
# Gere uma chave gratuita em https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Necessárias para o app do aluno poder avisar por notificação push
# quando uma vaga de reposição abre. Gere um par de chaves (uma vez só,
# guarde e reuse sempre) com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:seuemail@exemplo.com
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
